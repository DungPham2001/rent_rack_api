NODE_ENV=development
PORT=4000
# One database per app: rentrack
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/rentrack?retryWrites=true&w=majority
# Required in production. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
CORS_ORIGINS=
# Fallback timezone (each shop has its own rules.timezone)
TIMEZONE=Asia/Ho_Chi_Minh

# Public URL of this API (privacy / account deletion pages)
PUBLIC_BASE_URL=

# App version gate (GET /v1/health, header X-App-Version -> 426 when older than MIN_APP_VERSION)
MIN_APP_VERSION=1.0.0
LATEST_APP_VERSION=1.0.0

# Sessions: access token 2h; not remembered: refresh sliding 3h, absolute 12h; "Ghi nhớ": sliding 30 days
ACCESS_TOKEN_MINUTES=120
REFRESH_IDLE_MINUTES=180
SESSION_MAX_HOURS=12
REMEMBER_IDLE_DAYS=30
REMEMBER_MAX_DAYS=365
MAX_SESSIONS_PER_ACCOUNT=10

# Password reset email. When SMTP_HOST is empty, outside production the code is returned as devToken.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=RentRack <no-reply@example.com>
RESET_CODE_MINUTES=30

# Optional: when set, /v1/jobs/run requires "Authorization: Bearer <CRON_SECRET>" (Vercel Cron sends it)
CRON_SECRET=

# Privacy page owner/contact
PRIVACY_OWNER=
PRIVACY_EMAIL=

# Per-IP limits. RATE_LIMIT=off disables them.
RATE_READ_PER_MIN=240
RATE_WRITE_PER_MIN=90
RATE_AUTH_PER_MIN=10
RATE_REGISTER_PER_HOUR=5
# 5 wrong passwords lock that email for 5 minutes
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=5
